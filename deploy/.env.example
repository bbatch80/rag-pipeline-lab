# Copy to deploy/.env on the host and replace every placeholder; never commit the copy.
SITE_ADDRESS=localhost            # ragpipelinelab.com on the VM
TAG=local                         # the image tag the release workflow deployed
HTTP_PORT=80                      # 8080/8443 on a Mac that already serves 80/443
HTTPS_PORT=443
POSTGRES_PASSWORD=replace-me
OPENAI_API_KEY=replace-me         # embeddings
ANTHROPIC_API_KEY=replace-me      # the planner
SNOWFLAKE_ACCOUNT=                # optional: without it the warehouse legs report "unavailable"
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
RAGLAB_DEMO_PASSWORD=replace-me   # the shared demo login
RAGLAB_SESSION_SECRET=replace-me  # any long random string (python -c "import secrets; print(secrets.token_hex(32))")
